# ───────────────────────────────────────────────────────────
# geesun_agent 生产部署环境变量（复制为 deploy/.env 后填写）
# 所有 CHANGEME 项必须用 openssl 生成强随机值：
#   openssl rand -hex 32   # NEXTAUTH_SECRET / ENCRYPTION_KEY 等 32 字节
#   openssl rand -hex 16   # SALT
#   openssl rand -hex 12   # POSTGRES / REDIS / CLICKHOUSE / MINIO 密码
# 注意：.env 含密钥，必须 chmod 600 且绝不提交；本 .env.example 为安全模板可提交。
# 全部配置项（geesun_agent / Phoenix / Langfuse / 日志栈）集中于此，
# 各 compose 通过 ${VAR} 引用（无默认值，漏填会在 up 时直接报错）。单一可信源。
# ───────────────────────────────────────────────────────────

# ── geesun_agent 基础（对接远端 vLLM / CubeSandbox）──
base_url=http://172.16.66.13:8003/v1
openai_api_key=sk-REPLACE_ME
model_name=Qwen3.6-35B-A3B
agent_workspace=/data/agent
upload_root=/data/uploads
report_root=/data/reports
mcp_token=REPLACE_ME

# ── MCP（geesun_mcp_server 容器化，服务名 geesun-mcp）──
# agent 经 appnet2 服务名访问该地址（覆盖 config.py 默认的 localhost:8000）；
# 改了 mcp_server_url 后，需确保 {AGENT_WORKSPACE}/mcp.json 也指向此地址
# （或删掉旧 mcp.json 让它用新默认值重新生成）。
mcp_server_url=http://geesun-mcp:8000/mcp
# MCP 镜像 tag（push 进 Harbor geesun_ai 项目）
MCP_TAG=1.0.1
# DLP 解密网关（compose 外，MCP 内部 httpx POST 加密文件）
DECRYPT_API_URL=http://REPLACE_ME_DECRYPT_HOST:PORT/decrypt
# CubeSandbox(E2B) 控制面（MCP 内 e2b_code_interpreter / upload_to_sandbox 使用）
# ⚠️ 实测修正：8003 是 vLLM（OpenAI /v1/*，非 E2B）；cube-api 控制面在 6000
# （GET :6000/sandboxes 返回 sandbox 列表即验证）。E2B_API_URL 必须指向 6000，
# 否则 E2BSandbox.connect 打 vLLM 返回 404，e2b 解析报 KeyError: 'code'（2026-09-02 实锤）。
E2B_API_URL=http://172.16.66.13:6000
E2B_API_KEY=REPLACE_ME
# ── CubeSandbox egress CA（sandbox 出网 TLS 拦截） ──
# 为什么必须挂 combined-ca.pem、【不能】直接用 rootCA.pem 单证书（2026-09-01 实测）：
#   rootCA.pem 只是 mkcert 单证书（约 1.7KB）。容器内 SSL_CERT_FILE 指向它后，
#   Python/pip/uv 的默认信任库被【整体替换】为这一个文件 → 系统根被全部排除：
#     ✓ 信任内网 mkcert 签发的 cube-egress 拦截证书
#     ✗ 不信任外网 pypi.org（GlobalSign 签发）→ agent 启动 uv sync 报
#       UnknownIssuer → 容器起不来。combined-ca.pem = mkcert CA + 系统根 bundle
#       （约 148 证书/227KB），两者缺一不可。
# 生成方式（处理流程）：宿主机执行  bash deploy/setup-combined-ca.sh
#   （自动合并本机 mkcert 单证书 + 系统根 ca-bundle 并去重，输出到下方 CA_MOUNT_SRC 指向路径）。
# 若 sandbox 代理未做 TLS 拦截(MITM)，可删 CA 挂载 + 此行。
SSL_CERT_FILE=/etc/ssl/certs/combined-ca.pem
# CubeSandbox SDK 的 ssl_cert 入参（config.py:59 字段 cube_ca_path；sandbox.py:24-30 候选链
# 第 1 优先）。容器内路径与上面的 SSL_CERT_FILE 同值——显式写死可避免候选链退化：
# 若本项留空且 SSL_CERT_FILE 也被改掉，则退到 BASE_DIR/certs/rootCA.pem（镜像内不存在）
# → ca_path="" → SDK 不设 ssl_cert（不报错但沙箱侧 TLS 校验行为改变）。生产实测值即此行。
CUBE_CA_PATH=/etc/ssl/certs/combined-ca.pem
# CA 证书在宿主机的路径（compose 用于 bind mount 进 agent/mcp 容器，相对 deploy/ 目录）。
# 该文件由 deploy/setup-combined-ca.sh 生成；生产机跑一次脚本即可，无需手动 cat 合并。
CA_MOUNT_SRC=../certs/combined-ca.pem

# ── agent 可调优 / 覆盖项（容器经 env_file 注入，pydantic 大小写不敏感匹配 src/core/config.py 字段）──
# 以下项本地开发模板(.env.example 在仓库根)有、deploy 模板此前遗漏；容器内默认走 config.py 代码值，
# 生产需覆盖（调模型输出上限、接 LDAP 登录、配 Cube 模板、调沙箱护栏）在此填。无需改 compose。

# 模型调优（config.py:11/86/99/107/110/114）
extra_models=[]
model_max_tokens=65536
model_call_timeout_sec=1800
# 流式块间隔空闲超时（秒，config.py:125）：两次解析出的流式 chunk 超过该值即判死中止——
# 只杀"引擎吐字停了"的静默流，不杀"正在正常长生成"的流；0 = 关闭（仅靠 model_call_timeout_sec
# 墙钟兜底）。与仓库根 .env.example 同名同值（2026-09-10 补：此前 deploy 模板遗漏，
# 容器内实际走代码默认 240，行为一致但无显式配置项）。
model_stream_chunk_timeout_sec=240
model_max_len=262144
model_max_tokens_margin=16384
summarization_trigger_tokens=20000

# CubeSandbox（config.py:35-37）
cube_template_id=
cube_api_url=http://172.16.66.13:6000
cube_api_key=e2b_0000000000000000000000000000000000000000

# LDAP / AD 登录（config.py:138-143）
ldap_server=ldap://192.168.1.241:389
ldap_base_dn=DC=geesun,DC=li
ldap_bind_user=geesunai
ldap_bind_password=REPLACE_ME
ldap_domain_format=%s@geesun.li
ldap_admin_group_dn=CN=geesun-admins,CN=Users,DC=geesun,DC=li

# JWT（config.py:146-148）
jwt_secret=REPLACE_ME_openssl_rand_hex32
jwt_algorithm=HS256
jwt_expire_hours=168

# 沙箱护栏（config.py:41-78；默认已在代码，生产调参在此覆盖）
sandbox_probe_commands=
sandbox_disk_warn_mb=200
sandbox_disk_hard_mb=50
sandbox_probe_ttl_sec=60
sandbox_idle_timeout_sec=3600
sandbox_guardrails_enabled=true
sandbox_completion_gate_enabled=true
sandbox_completion_gate_auto_continue=false
sandbox_completion_gate_max_retries=2
sandbox_tool_failure_threshold=5
no_progress_repeat_threshold=5
no_progress_max_injections=1
no_progress_window_files=3

# LoopDetectionMiddleware（config.py:104-111；与仓库根 .env.example 同名同值）
# 2026-09-10 补：此前 deploy 模板遗漏，容器内走代码默认（下列数值即默认），现显式配置便于调参。
# Layer1 按「工具名+参数指纹」查重复调用，Layer2 按「同工具名滑动窗口频次」查空转；
# 每层 warn 注入软提醒，hard 剥离 tool_calls 逼模型出纯文本（不抛异常，SSE 不中断）。
loop_detect_warn_threshold=3
loop_detect_hard_limit=5
loop_detect_tool_freq_warn=12
loop_detect_tool_freq_hard=20

# TerminalResponseMiddleware（config.py terminal_response_max_retries；与仓库根 .env.example 同名同值）
# 2026-09-11 新增：堵「模型吐空响应但流程当正常结束」——此前 M3 完成门把「模型没说话」
# 误报成「你没下载作业」（生产会话 GY24428:0f6d781d，末次调用 336s 后返回完全空响应）。
# 四分支判定：正常 / thinking 截断 / 思考完没说 / 彻底空；命中则删空消息 + 重跑一轮 +
# 注入用户不可见的恢复提示；重试仍空则落盘可读降级文案。详见 src/core/terminal_response.py。
# 取值 = 每次 run 的自动重试次数：1 = 沿用 deer-flow（默认）；0 = 关闭重试仅落文案。
# 注意：改本值需重启容器才生效（settings 在模块导入时实例化，非热加载）。
terminal_response_max_retries=1

# store 回放副本长度上限（config.py persist_max_*；与仓库根 .env.example 同名同值）
# 2026-09-12 新增：修「AI 正文被 content[:2000] 砍掉 90.4%」——生产会话 GY24428:0f6d781d
# 当轮完整输出相机参数表，刷新后只剩前半截（store 2000 / checkpoint 20808，严格前缀）。
# 原则（对齐 deer-flow / deepseek-harness）：压缩只能发生在「喂给模型的上下文投影」层，
# 回放原文全量存；前端要收敛展示就用折叠，不让后端替前端做减法。
# ⚠ 本组只影响 store 回放副本与 SSE tool_result，不占模型上下文——模型那份走 checkpointer
# 的 messages channel，由 deepagents eviction(20000 token)/摘要另管，两者是独立旋钮。
# 前面 0 = 不限制（正文/reasoning 默认不截，全库最大实测 272833 字符）；
# 中间为工具结果上限（全库 737 条最大 39758，同时用于 SSE 保证当轮/刷新一致）；
# 末项为 SSE error 文本上限（错误摘要本就短，维持原值）。
persist_max_content_chars=0
persist_max_tool_result_chars=8000
persist_max_error_chars=500
# 2026-09-12 新增：增量写入时单条 entry 的体积观测闸（只 warn，绝不截断/丢弃）。
# 生产实测单条最大 278 KB → 1048576 留 3.6× 余量。
# 刻意没有"每会话条数上限"：deer-flow / deepseek-harness 均不设该维度（与上下文压力无关）。
persist_max_item_bytes=1048576
# 单次读取消息条数（GET /sessions/{id}/messages）。实测最大会话 259 条，1000 有 3.9× 余量。
persist_message_page_size=1000

# ── 日志（LOG_FORMAT=json 供 Loki 按字段索引；text 供本地看）──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── agent 专属 Postgres（agent_mem，容器服务名 agent-postgres）──
# 注意（2026-09-10 核准）：agent 读的 pydantic 字段是 postgres_host / postgres_port /
# postgres_user / postgres_db / postgres_password（src/core/config.py:164-168，
# DSN 拼装在 src/infra/database.py:30-34），而本模板用 AGENT_PG_* 表达，由
# docker-compose.yml:36-40 的 environment: 块映射注入 POSTGRES_*（优先级高于 env_file）。
# 所以这里**不要**再写 POSTGRES_HOST/POSTGRES_PORT —— 下面的 POSTGRES_USER/PASSWORD/DB
# 三项是给 Langfuse 自带 postgres 服务用的，若照抄成 agent 的值会被 environment:
# 覆盖成 AGENT_PG_* 的真值（生产容器实测 POSTGRES_HOST=agent-postgres、
# POSTGRES_DB=agent_mem_prod 即此机制生效），留在 .env 里只会误导后来人。
AGENT_PG_HOST=agent-postgres
AGENT_PG_PORT=5432
AGENT_PG_USER=geesun
AGENT_PG_DB=agent_mem
AGENT_PG_PASSWORD=REPLACE_ME_STRONG

# ── agent 工作目录（宿主机挂载根，防容器重建丢数据）──
AGENT_DATA_ROOT=/opt/geesun/data

# ── 追踪 collector ──
# agent OTLP traces/metrics 统一发往 Alloy（appnet2 内 alloy:4317，由它转发到 Phoenix 并 remote_write 到 Prometheus）。
# Phoenix 自 2026-09-02 起纳入本 stack（--with=phoenix，见 docker-compose.phoenix.yml），不再依赖现网共享实例：
#   原共享实例（compose 项目 opt 的 opt-phoenix-1）RestartPolicy=no，2026-09-01 14:58 被优雅停止后
#   未再启动 → 6006/4317 无监听 → Alloy 转发持续 `connection refused` 并 Dropping data（实测）。
#   旧值 10.10.10.67:4317 即指向那个死端口，不要再改回去。
PHOENIX_COLLECTOR_ENDPOINT=http://alloy:4317
# Alloy → Phoenix traces 转发目标（无 scheme，仅 host:port）。Phoenix 在本 stack 内，用服务名
PHOENIX_OTLP_ENDPOINT=phoenix:4317
# Langfuse 现随栈自托管（--with=langfuse），agent 经主机 LAN IP :3000 直发（与 Phoenix 同形态）；
#   如需走服务名可改 http://langfuse-web:3000（仅 appnet2 内，需同步把 langfuse-web 的 3000 改为不发布主机）。
LANGFUSE_BASE_URL=http://10.10.10.67:3000
OTEL_PROJECT_NAME=Geesun-Agent-prod
# OTel resource service.name → Prometheus job 标签（缺省 unknown_service，无法按服务筛选）
OTEL_SERVICE_NAME=geesun-agent

# ── 前端跨域源 ──
# 生产前端走域名 agent.geesun.com：前端全部请求用相对路径 /api/*，由 Caddy :80
# 同域反代到 geesun-agent:8009，zero CORS（无需本项）。这里保留后端 IP + 域名双列，
# 覆盖「直连后端 IP」与「域名」两种来源，防未来绝对 URL 残留跨域。
CORS_ALLOW_ORIGINS=http://10.10.10.67,http://agent.geesun.com

# 注意：生产不再设置 NEXT_PUBLIC_API_BASE（前端已全面改相对路径）。
# 该变量仅本地 next dev（next.config.ts rewrites）转发 /api/* 用，默认 localhost 兜底。

# ── 镜像仓库（Harbor，HTTP，单仓）──
# 生产实测（2026-09-02）：REGISTRY_HUB 与 REGISTRY_GEESUN 同值 = geesun_ai，
# 第三方通用镜像（pgvector / caddy / loki / alloy / prometheus / grafana / phoenix /
#   langfuse / clickhouse / minio / redis / postgres / node-exporter / cadvisor 等）
#   也全部放 geesun_ai 一个仓库。
# REGISTRY_HUB 变量名保留（compose 按它取第三方镜像）；将来若恢复 dockerhub proxy
# 拆分方案，只改 REGISTRY_HUB 一个值即可。
REGISTRY_GEESUN=172.16.220.74:8333/geesun_ai
REGISTRY_HUB=172.16.220.74:8333/geesun_ai
GEESUN_AGENT_TAG=1.0.9
# Alloy 镜像 tag（统一采集器，替代 Promtail）；以 `docker pull grafana/alloy:latest` 实测最新稳定 = v1.19.2 固定
ALLOY_TAG=v1.19.2
# Prometheus 镜像 tag（自建 metrics 后端，需 2.48+ 以支持 --web.enable-remote-write-receiver）
PROMETHEUS_TAG=3.0
# node-exporter 镜像 tag（主机 CPU/内存/磁盘/网络/负载指标 → Grafana「主机概览」看板数据源）
NODE_EXPORTER_TAG=v1.8.2
# cAdvisor 镜像 tag（容器级 CPU/内存/网络/文件系统指标 → Grafana「容器概览」看板数据源）
# v0.49+ 起支持 containerd snapshotter：本机 Docker 29 用 io.containerd.snapshotter.v1
# （镜像层在 /var/lib/containerd 而非 /var/lib/docker/overlay2），低版本会抓不到容器名。
# ⚠️ 2026-09-10 修正：原值 v0.49.1 与 build-push.sh:59/66 的内置默认 v0.57.0、
# docker-compose.yml:301 的 ${CADVISOR_TAG:-v0.57.0} 三处不一致。照旧值 cp 成 .env 会让
# build-push.sh 把 v0.49.1 同步进 Harbor、compose 也去拉 v0.49.1 → 生产静默降级到旧版。
# 现统一为 v0.57.0（ghcr.io/google/cadvisor 官方发布，实测可达）。
CADVISOR_TAG=v0.57.0
# 前端镜像 tag
WEB_TAG=1.0.3
# ⚠️ 前端 API 地址：本模板**故意不设置** NEXT_PUBLIC_API_BASE（2026-09-10 移除）。
# 原因链：
#   1) 它是 build-time 变量——build-push.sh:129-139 会读 .env 的 NEXT_PUBLIC_API_BASE，
#      非空就 --build-arg 内联进浏览器 JS 产物，运行时改 env 无效；
#   2) 生产前端全部走相对路径 /api/*，由 Caddy :80 同域反代到 geesun-agent:8009，
#      根本不需要绝对 URL（geesun_agent_web lib/sse-client.ts resolveChatUrl 已内建
#      NODE_ENV==="production" 短路为相对路径，Dockerfile 的 ARG 默认值亦已改空）；
#   3) 旧值 http://10.10.10.67/ 一旦被注入，浏览器产物里就固化一个内网绝对地址，
#      换域名/换 IP 即翻车（这正是 2026-09-09 那次生产回归的形态）。
# 生产 .env 实测本项不存在 → API_BASE 为空 → 不注入任何 --build-arg，行为与预期一致。
# 仅当临时构建指向非默认后端的本地调试包时才显式加回本行。
# Langfuse 镜像 tag（必须 pin 具体补丁版本，禁止浮动 :3）
# 说明：你本地 langfuse 源码仓库是 4.0.0（开发主线），但 Langfuse 自托管官方发布的
# Docker 镜像走 :3 稳定线，4.0.0 暂无可拉取镜像 tag；此处 pin 到最新稳定 3.x = 3.224.3。
# 若需严格对齐 4.0.0，需从源码自行构建镜像（见 DEPLOYMENT.md §10）。
LANGFUSE_TAG=3.224.3
POSTGRES_VERSION=17

# ── Phoenix（Arize 可观测栈）──
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=REPLACE_ME_STRONG
PHOENIX_DB_NAME=phoenix
# 由上面三项拼出；phoenix 服务与 phoenix-db 共用
PHOENIX_SQL_DATABASE_URL=postgresql://phoenix:REPLACE_ME_STRONG@phoenix-db:5432/phoenix

# ── Langfuse（可观测栈，随 --with=langfuse 自托管；变量名与 docker-compose.langfuse.yml 严格对应）──
# 注：Langfuse 现已纳入本 swarm stack 统一启动（不再复用现网共享实例），以下变量为必填；
#     自托管为全新空库，LANGFUSE_PUBLIC_KEY/SECRET_KEY 必须对应本实例项目（见下方 INIT 引导）。
# Web / Worker 初始化
NEXTAUTH_URL=http://10.10.10.67:3000
NEXTAUTH_SECRET=REPLACE_ME_openssl_rand_hex32
SALT=REPLACE_ME_openssl_rand_hex16
ENCRYPTION_KEY=REPLACE_ME_openssl_rand_hex32
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# 主库连接串（密码必须与下方 POSTGRES_PASSWORD 一致）
DATABASE_URL=postgresql://postgres:REPLACE_ME_openssl_rand_hex12@postgres:5432/postgres

# Langfuse 后端 postgres（服务自身凭据）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex12
POSTGRES_DB=postgres

# Clickhouse
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=REPLACE_ME_openssl_rand_hex12
CLICKHOUSE_CLUSTER_ENABLED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=REPLACE_ME_openssl_rand_hex12
REDIS_TLS_ENABLED=false
LANGFUSE_BULLMQ_SKIP_REDIS_VERSION_CHECK=false

# Langfuse 官方要求：下列三个 S3 密钥必须 = MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_ME_openssl_rand_hex12
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=REPLACE_ME_openssl_rand_hex12
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=REPLACE_ME_openssl_rand_hex12
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=REPLACE_ME_openssl_rand_hex12

# S3 事件桶（events）
LANGFUSE_USE_AZURE_BLOB=false
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

# S3 媒体桶（media，浏览器经主机 9092 访问；现网共享 minio 已发布 9092）
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_MEDIA_UPLOAD_EXTERNAL_ENDPOINT=http://10.10.10.67:9092

# S3 批量导出桶（默认关闭）
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://10.10.10.67:9092

# 首次启动初始化（留空则在 UI 手动创建；生产建议填写）
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
# 首次启动初始化项目时用的 key（须与下方 LANGFUSE_PUBLIC_KEY/SECRET_KEY 完全一致，agent traces 才会落入该项目）
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-init-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-init-CHANGE_ME
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# 你的 Langfuse 项目 API Keys（agent traces 落点；回填后重启 geesun-agent 生效）。
# ⚠️ 自托管 Langfuse 为全新空库：本处 key 必须与上面 LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY
#   完全一致（首次启动按 INIT 自动建项目），否则 agent 上报 401 / 无项目。从共享实例迁来时旧 key 失效。
LANGFUSE_PUBLIC_KEY=pk-lf-init-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-init-CHANGE_ME

# ── Grafana（日志检索界面，主机 127.0.0.1:3100）──
GRAFANA_PASSWORD=REPLACE_ME
