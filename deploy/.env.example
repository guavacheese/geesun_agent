# ───────────────────────────────────────────────────────────
# geesun_agent 生产部署环境变量（复制为 deploy/.env 后填写）
# 所有 CHANGEME 项必须用 openssl 生成强随机值：
#   openssl rand -hex 32   # NEXTAUTH_SECRET / ENCRYPTION_KEY 等 32 字节
#   openssl rand -hex 16   # SALT
#   openssl rand -hex 12   # POSTGRES / REDIS / CLICKHOUSE / MINIO 密码
# 注意：.env 含密钥，必须 chmod 600 且绝不提交；本 .env.example 为安全模板可提交。
# 全部配置项（geesun_agent / Phoenix / Langfuse / 日志栈）集中于此，
# 各 compose 通过 ${VAR} 引用（无默认值，漏填会在 up 时直接报错）。单一可信源。
# ───────────────────────────────────────────────────────────

# ── geesun_agent 基础（对接远端 vLLM / CubeSandbox）──
base_url=http://172.16.66.13:8003/v1
openai_api_key=sk-REPLACE_ME
model_name=Qwen3.6-35B-A3B
agent_workspace=/data/agent
upload_root=/data/uploads
report_root=/data/reports
mcp_token=REPLACE_ME

# ── MCP（geesun_mcp_server 容器化，服务名 geesun-mcp）──
# agent 经 appnet 服务名访问该地址（覆盖 config.py 默认的 localhost:8000）；
# 改了 mcp_server_url 后，需确保 {AGENT_WORKSPACE}/mcp.json 也指向此地址
# （或删掉旧 mcp.json 让它用新默认值重新生成）。
mcp_server_url=http://geesun-mcp:8000/mcp
# MCP 镜像 tag（push 进 Harbor geesun_ai 项目）
MCP_TAG=1.0.0
# DLP 解密网关（compose 外，MCP 内部 httpx POST 加密文件）
DECRYPT_API_URL=http://REPLACE_ME_DECRYPT_HOST:PORT/decrypt
# CubeSandbox(E2B) 代理（MCP 内 e2b_code_interpreter 使用）
E2B_API_URL=http://172.16.66.13:8003
E2B_API_KEY=REPLACE_ME
# MCP 容器内信任的 CubeSandbox egress CA 路径（挂载源由下方 CA_MOUNT_SRC 指定）；
# 若 sandbox 代理未做 TLS 拦截(MITM)，可删 CA 挂载 + 此行。
SSL_CERT_FILE=/etc/ssl/certs/cube-root-ca.crt
# CA 证书在宿主机的路径（compose 用于 bind mount 进 mcp 容器，相对 deploy/ 目录）
CA_MOUNT_SRC=../certs/cube-root-ca.crt

# ── 日志（LOG_FORMAT=json 供 Loki 按字段索引；text 供本地看）──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── agent 专属 Postgres（agent_mem，容器服务名 agent-postgres）──
AGENT_PG_HOST=agent-postgres
AGENT_PG_PORT=5432
AGENT_PG_USER=geesun
AGENT_PG_DB=agent_mem
AGENT_PG_PASSWORD=REPLACE_ME_STRONG

# ── agent 工作目录（宿主机挂载根，防容器重建丢数据）──
AGENT_DATA_ROOT=/opt/geesun/data

# ── 追踪 collector（同网络服务名）──
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:4317
LANGFUSE_BASE_URL=http://langfuse-web:3000
OTEL_PROJECT_NAME=Geesun-Agent-prod

# ── 前端跨域源（前端经 Caddy 同域 http://10.10.10.67/，一般无跨域；按实际域名/IP 调整）──
CORS_ALLOW_ORIGINS=http://10.10.10.67

# ── 镜像仓库（Harbor，HTTP，拆分项目）──
# geesun_ai：自有应用（geesun-agent）；dockerhub：第三方通用镜像中央仓库
#   （redis / minio / postgres / pgvector / loki / grafana / phoenix / langfuse 等）
# 由 deploy/build-push.sh 构建 / 同步进对应项目。
REGISTRY_GEESUN=172.16.220.74:8333/geesun_ai
REGISTRY_HUB=172.16.220.74:8333/dockerhub
GEESUN_AGENT_TAG=1.0.0
# 前端镜像 tag（构建期注入 NEXT_PUBLIC_API_BASE，见 build-push.sh sync_web；运行时改无效）
WEB_TAG=1.0.0
# Langfuse 镜像 tag（必须 pin 具体补丁版本，禁止浮动 :3）
# 说明：你本地 langfuse 源码仓库是 4.0.0（开发主线），但 Langfuse 自托管官方发布的
# Docker 镜像走 :3 稳定线，4.0.0 暂无可拉取镜像 tag；此处 pin 到最新稳定 3.x = 3.224.3。
# 若需严格对齐 4.0.0，需从源码自行构建镜像（见 DEPLOYMENT.md §10）。
LANGFUSE_TAG=3.224.3
POSTGRES_VERSION=17

# ── Phoenix（Arize 可观测栈）──
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=REPLACE_ME_STRONG
PHOENIX_DB_NAME=phoenix
# 由上面三项拼出；phoenix 服务与 phoenix-db 共用
PHOENIX_SQL_DATABASE_URL=postgresql://phoenix:REPLACE_ME_STRONG@phoenix-db:5432/phoenix

# ── Langfuse（可观测栈，变量名与 docker-compose.langfuse.yml 严格对应）──
# Web / Worker 初始化
NEXTAUTH_URL=http://10.10.10.67:3000
NEXTAUTH_SECRET=REPLACE_ME_openssl_rand_hex32
SALT=REPLACE_ME_openssl_rand_hex16
ENCRYPTION_KEY=REPLACE_ME_openssl_rand_hex32
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# 主库连接串（密码必须与下方 POSTGRES_PASSWORD 一致）
DATABASE_URL=postgresql://postgres:REPLACE_ME_openssl_rand_hex12@postgres:5432/postgres

# Langfuse 后端 postgres（服务自身凭据）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex12
POSTGRES_DB=postgres

# Clickhouse
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=REPLACE_ME_openssl_rand_hex12
CLICKHOUSE_CLUSTER_ENABLED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=REPLACE_ME_openssl_rand_hex12
REDIS_TLS_ENABLED=false
LANGFUSE_BULLMQ_SKIP_REDIS_VERSION_CHECK=false

# Langfuse 官方要求：下列三个 S3 密钥必须 = MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_ME_openssl_rand_hex12
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=REPLACE_ME_openssl_rand_hex12
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=REPLACE_ME_openssl_rand_hex12
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=REPLACE_ME_openssl_rand_hex12

# S3 事件桶（events）
LANGFUSE_USE_AZURE_BLOB=false
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

# S3 媒体桶（media，浏览器经主机 9092 访问）
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_MEDIA_UPLOAD_EXTERNAL_ENDPOINT=http://10.10.10.67:9092

# S3 批量导出桶（默认关闭）
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://10.10.10.67:9092

# 首次启动初始化（留空则在 UI 手动创建；生产建议填写）
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# 你的 Langfuse 项目 API Keys（Settings → API Keys，回填后重启 geesun-agent 生效）
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME

# ── Grafana（日志检索界面，主机 127.0.0.1:3100）──
GRAFANA_PASSWORD=REPLACE_ME
