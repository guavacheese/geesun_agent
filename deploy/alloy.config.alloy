// Alloy 统一采集配置（替代原 Promtail）
// 信号路由：
//   logs   : appnet2 容器 stdout(JSON) → Loki（等价于原 Promtail 的 docker_sd + relabel + pipeline_stages）
//   metrics: agent 经 OTLP 发来 → Prometheus（自建，remote_write）
//   traces : agent 经 OTLP 发来 → Phoenix（路线 A=现网共享实例 10.10.10.67:4317；路线 B=phoenix:4317，由 PHOENIX_OTLP_ENDPOINT 控制）
// agent 侧：PHOENIX_COLLECTOR_ENDPOINT / OTEL_EXPORTER_OTLP_ENDPOINT 均指向 http://alloy:4317（appnet 内统一入口）
// 镜像版本：.env 的 ALLOY_TAG=v1.19.2（docker-compose.yml 默认值同步）
// 注意：PHOENIX_OTLP_ENDPOINT 经 env() 函数读取（由 env_file 注入，v1.19 已移除 --config.expand-env）
//
// 2026-11-05 防复发：
//   1) discovery.docker 显式 refresh_interval=60s（原默认 15s 会频繁重建 tailer，重复读历史）
//   2) 丢弃 ClickHouse FileChannel 坏死时的递归刷屏堆栈（曾造成 24h 写入 15G Loki chunk）
//   3) 注意：实测 loki.source.docker 的 refresh_interval 不改变
//      "finished transferring logs" 的 15s 节奏（仍为 ~15s），该日志属采集轮询本身；
//      真正止血是 P0 修好 CH，写入量已从 13.4G/天降到 ~87MiB/天。

logging {
  level  = "info"
  format = "logfmt"
}

// ───────────────────────── Logs ─────────────────────────
// discovery.docker 发现容器 → discovery.relabel 过滤 appnet2 网络 + 提取容器名
// → loki.source.docker 读日志（Swarm 实际网络名带 stack 前缀 geesun_appnet2）
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "60s"
}

discovery.relabel "appnet_only" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "geesun_appnet2"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// 直接通过 Docker API 读容器日志（无需挂宿主机 /var/lib/docker/containers）
loki.source.docker "logs" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "60s"
  targets    = discovery.relabel.appnet_only.output
  forward_to = [loki.process.stage.receiver]
}

// 提取应用 JSON 字段为索引标签（与原 Promtail pipeline_stages 对应）
// v1.19 语法：stage 必须带类型后缀（stage.json / stage.labels），不再支持裸 stage {} 块
loki.process "stage" {
  forward_to = [loki.write.default.receiver]

  // 2026-11-05: 丢弃 ClickHouse Poco FileChannel 坏死时的递归堆栈。
  // 该异常每条日志都会触发一次，曾以 ~22 MiB/min 刷屏并被 Loki 放大到 15G/天。
  stage.drop {
    expression          = ".*(Cannot log message in OwnAsyncSplitChannel|RotateBySizeStrategy::mustRotate|Poco::FileChannel).*"
    drop_counter_reason = "clickhouse_broken_logger_stacktrace"
  }

  stage.json {
    expressions = {
      level  = "level",
      logger = "logger",
      msg    = "msg",
      ts     = "ts",
    }
  }
  stage.labels {
    values = {
      level  = "",
      logger = "",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ──────────────── OTLP 统一入口（metrics + traces）────────────────
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4321"
  }
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlp.phoenix.input]
  }
}

// traces → Phoenix（OpenInference OTLP gRPC）
//   路线 A（默认）：PHOENIX_OTLP_ENDPOINT 缺省 = 现网共享实例 10.10.10.67:4317
//   路线 B（自托管 phoenix compose）：在 .env 设 PHOENIX_OTLP_ENDPOINT=phoenix:4317
otelcol.exporter.otlp "phoenix" {
  client {
    endpoint = env("PHOENIX_OTLP_ENDPOINT")
    tls {
      insecure = true
    }
  }
}

// metrics → 自建 Prometheus（remote_write；Prometheus 需开启 --web.enable-remote-write-receiver）
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
