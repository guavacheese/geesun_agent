// Alloy 统一采集配置（替代原 Promtail）
// 信号路由：
//   logs   : appnet2 容器 stdout(JSON) → Loki（等价于原 Promtail 的 docker_sd + relabel + pipeline_stages）
//   metrics: agent 经 OTLP 发来 → Prometheus（自建，remote_write）
//   traces : agent 经 OTLP 发来 → Phoenix（路线 A=现网共享实例 10.10.10.67:4317；路线 B=phoenix:4317，由 PHOENIX_OTLP_ENDPOINT 控制）
// agent 侧：PHOENIX_COLLECTOR_ENDPOINT / OTEL_EXPORTER_OTLP_ENDPOINT 均指向 http://alloy:4317（appnet 内统一入口）
// 镜像版本：见 build-push.sh 的 ALLOY_TAG（以 `docker pull grafana/alloy:latest` 实测 tag 固定，如 1.8.x）
// 注意：配置含 ${PHOENIX_OTLP_ENDPOINT:-...} 环境变量展开，alloy 必须以 --config.expand-env 启动（见 docker-compose.yml command）

logging {
  level  = "info"
  format = "logfmt"
}

// ───────────────────────── Logs ─────────────────────────
// loki.source.docker 自带 Docker API 容器发现（无需 discovery.docker）；
// 网络过滤/标签注入用 relabel_rules 传入（Swarm 实际网络名带 stack 前缀 geesun_）（v1.19 语法：loki.relabel 定义规则 + receiver 链路）
loki.relabel "appnet_only" {
  forward_to = [loki.process.stage.receiver]

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "geesun_appnet2"
    action        = "keep"
  }
}

// 直接通过 Docker API 读容器日志（无需挂宿主机 /var/lib/docker/containers）
loki.source.docker "logs" {
  host          = "unix:///var/run/docker.sock"
  forward_to    = [loki.relabel.appnet_only.receiver]
  relabel_rules = loki.relabel.appnet_only.rules
}

// 提取应用 JSON 字段为索引标签（与原 Promtail pipeline_stages 对应）
// v1.19 语法：stage 必须带类型后缀（stage.json / stage.labels），不再支持裸 stage {} 块
loki.process "stage" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level  = "level",
      logger = "logger",
      msg    = "msg",
      ts     = "ts",
    }
  }
  stage.labels {
    values = {
      level  = "",
      logger = "",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ──────────────── OTLP 统一入口（metrics + traces）────────────────
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4321"
  }
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlp.phoenix.input]
  }
}

// traces → Phoenix（OpenInference OTLP gRPC）
//   路线 A（默认）：PHOENIX_OTLP_ENDPOINT 缺省 = 现网共享实例 10.10.10.67:4317
//   路线 B（自托管 phoenix compose）：在 .env 设 PHOENIX_OTLP_ENDPOINT=phoenix:4317
otelcol.exporter.otlp "phoenix" {
  client {
    endpoint = "${PHOENIX_OTLP_ENDPOINT:-10.10.10.67:4317}"
    tls {
      insecure = true
    }
  }
}

// metrics → 自建 Prometheus（remote_write；Prometheus 需开启 --web.enable-remote-write-receiver）
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
