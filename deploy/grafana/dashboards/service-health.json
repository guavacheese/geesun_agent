{
  "uid": "geesun-health",
  "title": "Geesun · 服务健康与采集链路",
  "tags": ["geesun", "health"],
  "description": "采集链路自监控（Prometheus targets / Loki 各容器日志活跃度）+ agent 业务指标（LLM token 消耗 / API 延迟）。业务指标来自 5b476e3 补的 OTel MeterProvider，经 alloy→Prometheus 落库；token 明细 trace 见 Langfuse(:3000)/Phoenix(:6006)。",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "采集目标存活（1=正常）",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "min(up{job=~\"prometheus|alloy|node-exporter|cadvisor\"})" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "采集目标数量",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "count(up)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "近 1h 有日志的容器数",
      "datasource": { "type": "loki", "uid": "geesun-loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "count(count_over_time({container=~\"geesun_.*\"}[1h]))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Prometheus 写入速率（样本/秒）",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])" }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "采集目标明细（up / 抓取耗时）",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "up", "legendFormat": "up", "format": "table", "instant": true },
        { "refId": "B", "expr": "scrape_duration_seconds", "legendFormat": "耗时", "format": "table", "instant": true }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "各容器近 1h 日志条数（0 = 静默，结合服务性质判断是否异常）",
      "datasource": { "type": "loki", "uid": "geesun-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (container) (count_over_time({container=~\"geesun_.*\"}[1h]))", "format": "table", "instant": true }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "全栈最新日志（tail）",
      "datasource": { "type": "loki", "uid": "geesun-loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        { "refId": "A", "expr": "{container=~\"geesun_.*\"}", "queryType": "range" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM Token 速率 (tokens/s · 按 input/output)",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[5m]))", "legendFormat": "{{gen_ai_token_type}}" }
      ],
      "_note": "指标名 gen_ai_client_token_usage_* 为 OTel 标准 semconv 名；若 Prometheus 中仍无此系列，说明 model.py 成功路径未取到 usage（token 维度未记录），需修 model.py token 提取（见诊断）。"
    },
    {
      "id": 9,
      "type": "stat",
      "title": "累计 Token 消耗 (input / output)",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"})", "legendFormat": "input" },
        { "refId": "B", "expr": "sum(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"})", "legendFormat": "output" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API P99 延迟 (毫秒)",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 18, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "API 请求速率 (req/s)",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_duration_milliseconds_count[5m]))", "legendFormat": "qps" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "LLM 调用速率 (calls/s) · 失败率",
      "datasource": { "type": "prometheus", "uid": "geesun-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(gen_ai_client_operation_duration_seconds_count[5m]))", "legendFormat": "calls/s" },
        { "refId": "B", "expr": "sum(rate(gen_ai_client_operation_duration_seconds_count{error_type!=\"\"}[5m]))", "legendFormat": "failed/s" }
      ]
    }
  ]
}
