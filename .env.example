# 环境变量模板：复制为 .env 并填入真实值
# 注意：.env 已被 git 跟踪排除（见 .gitignore），真实凭据禁止提交

OPENAI_API_KEY=your_openai_api_key
MODEL_NAME=Qwen3.6-35B-A3B
BASE_URL=http://172.16.66.13:8003/v1
# 额外预装模型（员工可选，JSON 数组）
EXTRA_MODELS='[]'
# 单次模型调用输出上限（tokens）：保留 Qwen3 thinking，贴近 max_model_len=262144 留 ~62k 输入余量；
# 注意 vLLM 约束 prompt+max_tokens ≤ max_model_len，输入接近 262k 时 200k 输出会 400
#（Summarization 在 20 万 tokens 触发压缩，实际输入远小于上限）
MODEL_MAX_TOKENS=200000
# 单次模型调用总时长超时（秒）：兜底防引擎卡死/生成失控永久挂起
MODEL_CALL_TIMEOUT_SEC=600
# 流式块间隔空闲超时（秒）：两次解析出的流式 chunk 间隔超过该值即判死中止——只杀
# "引擎吐字停了"的静默流，不杀"正在正常长生成"的流。0 = 关闭（仅靠上方墙钟兜底）
MODEL_STREAM_CHUNK_TIMEOUT_SEC=240
# vLLM 上下文总上限（prompt+max_tokens 不得超过，探活 /v1/models 得 262144）
MODEL_MAX_LEN=262144
# 动态 max_tokens 安全边距：防 prompt 估算低估触发 vLLM 400（默认 16384）
MODEL_MAX_TOKENS_MARGIN=16384
# Summarization 压缩触发阈值（tokens）：上下文达此值即把历史压缩为摘要（默认 100000）
SUMMARIZATION_TRIGGER_TOKENS=100000

# Arize Phoenix 追踪（OpenTelemetry OTLP gRPC endpoint）
PHOENIX_COLLECTOR_ENDPOINT=

# Langfuse 追踪（OpenTelemetry HTTP ingest）
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

AGENT_WORKSPACE=/mnt/d/workspace/geesun_agent
UPLOAD_ROOT=/mnt/d/workspace/geesun_agent/data/uploads
REPORT_ROOT=/mnt/d/workspace/geesun_agent/data/reports

# CubeSandbox（模板 ID 用 cubemastercli tpl list 查询，需带 --allow-out-cidr 放行 devpi 网段）
CUBE_TEMPLATE_ID=
CUBE_API_URL=http://172.16.66.13:6000
CUBE_API_KEY=e2b_0000000000000000000000000000000000000000
# CubeSandbox 交互 CA 证书路径（pydantic 字段：dev 从 .env 读，生产经 compose env_file 注入）。
# 留空会落回 certs/rootCA.pem（可能不存在）→ 坏路径被写进 SSL_CERT_FILE → 同进程后续
# ChatOpenAI 构造 httpx 崩溃 FileNotFoundError → chat 500（2026-09-09 实测）
CUBE_CA_PATH=
SSL_CERT_FILE=/home/dhp/projects/cube-cert/rootCA.pem

POSTGRES_HOST=192.168.10.136
POSTGRES_PORT=5433
POSTGRES_DB=agent_mem
POSTGRES_USER=geesun
POSTGRES_PASSWORD=your_password

# LDAP / AD
LDAP_SERVER=ldap://192.168.1.241:389
LDAP_BASE_DN=DC=geesun,DC=li
LDAP_BIND_USER=geesunai
LDAP_BIND_PASSWORD=your_password
LDAP_ADMIN_GROUP_DN=CN=geesun-admins,CN=Users,DC=geesun,DC=li
LDAP_DOMAIN_FORMAT=%s@geesun.li

# JWT（生成一个随机字符串，勿用示例值）
JWT_SECRET=generate_a_random_string
# 7天
JWT_EXPIRE_HOURS=168

# ─── LoopDetectionMiddleware（2026-09-08 移植 deer-flow，防烧满 recursion_limit）───
# 两层检测：Layer1 按「工具名+参数指纹」查重复调用，Layer2 按「同工具名滑动窗口频次」查空转。
# 每层两个阈值——warn 注入软提醒；hard 剥离 tool_calls 逼模型出纯文本（不抛异常，SSE 不中断）。
# 留空即用 src/core/config.py 内置默认值（下列数值即当前默认）。
LOOP_DETECT_WARN_THRESHOLD=3
LOOP_DETECT_HARD_LIMIT=5
LOOP_DETECT_TOOL_FREQ_WARN=12
LOOP_DETECT_TOOL_FREQ_HARD=20

# ─── TerminalResponseMiddleware（2026-09-11 新增，堵「空响应被当正常结束」）───
# 四分支判定：正常 / thinking 截断(content 空+reasoning 非空+finish_reason=length) /
# 思考完没说(content 空+reasoning 非空+stop) / 彻底空。命中则删掉空 AIMessage +
# jump_to="model" 重跑一轮，并注入用户不可见的恢复提示（request.override，不写 state）；
# 重试仍空则落盘可读降级文案（不再抛异常，SSE 不中断）。详见 src/core/terminal_response.py。
# 取值 = 每次 run 的自动重试次数。1 = 沿用 deer-flow；5 = deepseek-harness（我们不用，
# 单次调用最坏 336s，5 次超 28 分钟）；0 = 关闭重试，仅落降级文案。
# 注意：settings 在模块导入时实例化，改本值需重启容器才生效（非热加载）。
TERMINAL_RESPONSE_MAX_RETRIES=1

# ─── store 回放副本长度上限（2026-09-12 新增，修 20808→2000 截断 bug）───
# 背景：生产会话 GY24428:0f6d781d 的 AI 正文被 content[:2000] 砍掉 90.4%（store 存 2000 /
# checkpoint 存 20808，程序化验证为严格前缀），用户刷新后只剩半张相机参数表。截断写在
# 持久化层＝写入即不可逆删除，方向错了层。
# 原则（对齐 deer-flow / deepseek-harness）：压缩只能发生在「喂给模型的上下文投影」层，
# 回放原文一律全量存；前端要收敛展示就用折叠，不让后端替前端做减法。
# ⚠ 本组只影响「store 回放副本」与 SSE tool_result 字段，**不占模型上下文**——模型那份走
# checkpointer 的 messages channel，由 deepagents eviction(20000 token)/摘要另管，两者独立。
# 取值：0 = 不限制。AI 正文/reasoning 是用户真正要看的交付物本体，默认不截（全库最大
# 正文实测 272833 字符）；真要收紧改本值即可，无需改代码。
PERSIST_MAX_CONTENT_CHARS=0
# 工具结果属中间过程（常是几十 KB 日志噪音），前端折叠查看即可，给中间上限。
# 全库实测 737 条工具结果最大 39758 字符，8000 覆盖绝大多数场景。
# 注意：此值同时用于 SSE tool_result 事件，保证「当轮看到」与「刷新看到」一致。
PERSIST_MAX_TOOL_RESULT_CHARS=8000
# SSE tool_result 事件的 error 文本上限（错误摘要本来就短，维持原值不放大）。
PERSIST_MAX_ERROR_CHARS=500
